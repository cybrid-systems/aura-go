; Dual duel on 9×9 with seeded agg/def bodies. honest worldline stamp (fiber_live only if every select joined).
(load "/workspace/aura-go/soft/go/duel.aura")

(define (main)
  (if (not (go:duel-boot! 9))
      (display "GO_M2_DUEL_FAIL seed\n")
      (begin
        (go:apply-strategy! 1 *agg-body*)
        (go:apply-strategy! 2 *def-body*)
        (let ((res (go:duel-play! 10)))
          (display "TICKS=")
          (display (number->string (car (cdr (cdr (cdr res))))))
          (newline)
          (display "LEAD=")
          (display (number->string (car res)))
          (newline)
          (display "CAPS_B=")
          (display (number->string (car (cdr res))))
          (newline)
          (display "CAPS_W=")
          (display (number->string (car (cdr (cdr res)))))
          (newline)
          (display "WINNER mid=")
          (display (number->string
                    (cond ((> (car res) 0) 1)
                          ((< (car res) 0) 2)
                          (#t 0))))
          (display " side=")
          (display (cond ((> (car res) 0) "B")
                         ((< (car res) 0) "W")
                         (#t "D")))
          (display " reason=capture_lead")
          (newline)
          (go:stamp-world!)
          (display "EXPLAIN mid=")
          (display (number->string *explain-mid*))
          (display " reason=")
          (display *explain-reason*)
          (newline)
          (if (and (>= (car (cdr (cdr (cdr res)))) 2)
                   (or (and (string=? *duel-world* "fiber_live")
                            (> *race-hit* 0)
                            (= *race-hit* *race-tried*)
                            (> *race-backend* 0))
                       (string=? *duel-world* "host-sequential")))
              (display "GO_M2_DUEL_OK\n")
              (display "GO_M2_DUEL_FAIL short\n"))))))

(main)
