;; 19×19 PK smoke. No MiniMax. A few moves, honest worldline stamp,
;; liberty feature, mid-match weight mutate. Not a rating.
(load "/workspace/aura-go/soft/go/duel.aura")

(define (world-ok?)
  (or (and (string=? *duel-world* "fiber_live")
           (> *race-hit* 0)
           (= *race-hit* *race-tried*)
           (> *race-backend* 0))
      (and (string=? *duel-world* "host-sequential")
           (= *race-hit* 0))))

(define (main)
  (if (not (go:duel-boot! 19))
      (display "GO_19_PK_FAIL seed\n")
      (begin
        (go:apply-strategy! 1 *agg-body*)
        (go:apply-strategy! 2 *def-body*)
        (if (not (= (go:size) 19))
            (display "GO_19_PK_FAIL size\n")
            (let ((res (go:duel-play! 8)))
              (display "TICKS=")
              (display (number->string (car (cdr (cdr (cdr res))))))
              (newline)
              (display "LEAD=")
              (display (number->string (car res)))
              (newline)
              (display "SIZE=")
              (display (number->string (go:size)))
              (newline)
              (display "LIB_WEIGHT=")
              (display (number->string *lib-weight*))
              (newline)
              (display "WINNER mid=")
              (display (number->string
                        (cond ((> (car res) 0) 1)
                              ((< (car res) 0) 2)
                              (#t 0))))
              (display " side=")
              (display (cond ((> (car res) 0) "B")
                             ((< (car res) 0) "W")
                             (#t "D")))
              (display " reason=capture_lead")
              (newline)
              (go:stamp-world!)
              (display "EXPLAIN mid=")
              (display (number->string *explain-mid*))
              (display " reason=")
              (display *explain-reason*)
              (newline)
              (if (and (= (go:size) 19)
                       (>= (car (cdr (cdr (cdr res)))) 6)
                       (= *rule-mutated* 1)
                       (= *lib-weight* 7)
                       (world-ok?)
                       (> (string-length *explain-reason*) 0))
                  (display "GO_19_PK_OK\n")
                  (display "GO_19_PK_FAIL short\n")))))))

(main)
