;; 9x9 regression, then one 19x19 sequence. Prints GO_M0_OK and GO_19_OK.
(load "/workspace/aura-go/soft/go/rules.aura")

(define *fail* 0)

(define (expect tag got want)
  (display tag)
  (display "=")
  (display (number->string got))
  (if (= got want)
      (display " OK")
      (begin
        (display " WANT=")
        (display (number->string want))
        (set! *fail* (+ *fail* 1))))
  (newline)
  got)

(define (must v)
  (if (and (number? v) (= v 1))
      1
      (begin
        (display "MUST_FAIL")
        (newline)
        (set! *fail* (+ *fail* 1))
        0)))

(expect "DEFAULT_N" (go:size) 19)
(expect "DEFAULT_CELLS" *CELLS* 361)
(expect "SET9" (go:set-size! 9) 9)
(display "DIALECT=")
(display (go:dialect))
(newline)

;; Point (9,0) is off a 9x9 board and on a 19x19 board.
(expect "OFF9" (go:place! 1 9 0) 0)
(expect "TO_PLAY_AFTER_OFF9" *to-play* 1)

;; --- single-stone capture that is NOT ko (capturer has liberties) ---
;; B(1,0), W(0,0), B(0,1) takes the corner white. B(0,1) is not in
;; atari, so *ko-color* stays 0.
(go:reset!)
(must (go:place! 1 1 0))
(must (go:place! 2 0 0))
(expect "OPEN_CAPTURE" (go:place! 1 0 1) 1)
(expect "OPEN_CAPS" *last-caps* 1)
(expect "KO_AFTER_OPEN" *ko-color* 0)
(expect "OPEN_EMPTY" (go:at 0 0) 0)

;; --- simple ko ---
;; Shape before Black plays at (2,0):
;;   B W . W
;;   . B W .
;; White at (1,0) has one liberty. Black fills it and is in atari.
;; White may not recapture at (1,0). A move elsewhere clears the ban.
;; After Black passes, White recaptures.
(go:reset!)
(must (go:place! 1 0 0))
(must (go:place! 2 1 0))
(must (go:place! 1 1 1))
(must (go:place! 2 3 0))
(must (go:place! 1 4 4))
(must (go:place! 2 2 1))
(expect "LIBERTY" (go:liberties 1 0) 1)
(expect "KO_PLAY" (go:place! 1 2 0) 1)
(expect "CAPTURE" *last-caps* 1)
(expect "KO" *ko-color* 2)
(expect "KO_X" *ko-x* 1)
(expect "KO_Y" *ko-y* 0)
(expect "KO_GROUP" (go:group-size 2 0) 1)
(expect "KO_LIBS" (go:liberties 2 0) 1)
(display "KO_BOARD")
(newline)
(go:print-board)
(expect "KO_BLOCK" (go:place! 2 1 0) 0)
(expect "STILL_EMPTY" (go:at 1 0) 0)
(expect "KO_CLEAR_PLAY" (go:place! 2 5 5) 1)
(expect "KO_AFTER_CLEAR" *ko-color* 0)
(expect "PASS" (go:pass!) 1)
(expect "PASSES" *passes* 1)
(expect "RECAPTURE" (go:place! 2 1 0) 1)
(expect "RECAP_CAPS" *last-caps* 1)
(expect "CAPS_BLACK" *caps-black* 1)
(expect "CAPS_WHITE" *caps-white* 1)

;; --- two-stone capture is not ko ---
;; B(2,0) W(0,0) B(0,1) W(1,0), then B(1,1) takes both whites.
(go:reset!)
(must (go:place! 1 2 0))
(must (go:place! 2 0 0))
(must (go:place! 1 0 1))
(must (go:place! 2 1 0))
(expect "MULTI_PLAY" (go:place! 1 1 1) 1)
(expect "MULTI" *last-caps* 2)
(expect "KO_AFTER_MULTI" *ko-color* 0)
(expect "MULTI_EMPTY_A" (go:at 0 0) 0)
(expect "MULTI_EMPTY_B" (go:at 1 0) 0)

;; --- suicide is illegal; the board is unchanged ---
;; B(1,0), W elsewhere, B(0,1). White at (0,0) fills no liberty of
;; either black stone and has none of its own.
(go:reset!)
(must (go:place! 1 1 0))
(must (go:place! 2 8 8))
(must (go:place! 1 0 1))
(expect "SUICIDE" (go:place! 2 0 0) 0)
(expect "SUICIDE_EMPTY" (go:at 0 0) 0)
(expect "TO_PLAY_STILL_WHITE" *to-play* 2)
(expect "PASS" (go:pass!) 1)
(expect "PASSES" *passes* 1)
(expect "EMPTY" (go:empty-count) 78)

;; ========== 19x19: place, capture, ko, suicide on the full board ==========
;; Same rules. Coordinates touch x=18 / y=18 so a 9-wide stride cannot pass.
(expect "SET19" (go:set-size! 19) 19)
(expect "SIZE19" (go:size) 19)
(expect "CELLS19" *CELLS* 361)
(display "DIALECT19=")
(display (go:dialect))
(newline)
(expect "EMPTY19_START" (go:empty-count) 361)
(expect "OFF19" (go:place! 1 18 19) 0)
(expect "OFF19_X" (go:place! 1 19 0) 0)
(expect "TO_PLAY_AFTER_OFF19" *to-play* 1)
(expect "FAR_PLACE" (go:place! 1 18 18) 1)
(expect "FAR_AT" (go:at 18 18) 1)
(expect "MID_PLACE" (go:place! 2 9 9) 1)
(expect "MID_AT" (go:at 9 9) 2)

;; Corner capture on the far edge. Capturer is not in atari, so not ko.
;; B(17,18) W(18,18) B(18,17) takes the corner white.
(go:reset!)
(must (go:place! 1 17 18))
(must (go:place! 2 18 18))
(expect "EDGE_CAPTURE" (go:place! 1 18 17) 1)
(expect "EDGE_CAPS" *last-caps* 1)
(expect "EDGE_KO_AFTER_OPEN" *ko-color* 0)
(expect "EDGE_EMPTY" (go:at 18 18) 0)

;; Simple ko on the right edge.
;; Before Black plays (17,0):
;;   x=15..18
;;   B W . W
;;   . B W .
;; White at (16,0) has one liberty. B(17,0) captures and is in atari.
(go:reset!)
(must (go:place! 1 15 0))
(must (go:place! 2 16 0))
(must (go:place! 1 16 1))
(must (go:place! 2 18 0))
(must (go:place! 1 0 10))
(must (go:place! 2 17 1))
(expect "EDGE_LIB" (go:liberties 16 0) 1)
(expect "EDGE_KO_PLAY" (go:place! 1 17 0) 1)
(expect "EDGE_KO_CAPS" *last-caps* 1)
(expect "EDGE_KO" *ko-color* 2)
(expect "EDGE_KO_X" *ko-x* 16)
(expect "EDGE_KO_Y" *ko-y* 0)
(expect "EDGE_KO_GROUP" (go:group-size 17 0) 1)
(expect "EDGE_KO_LIBS" (go:liberties 17 0) 1)
(expect "EDGE_KO_BLOCK" (go:place! 2 16 0) 0)
(expect "EDGE_STILL_EMPTY" (go:at 16 0) 0)
(expect "EDGE_KO_CLEAR" (go:place! 2 9 9) 1)
(expect "EDGE_KO_CLEARED" *ko-color* 0)

;; Suicide in the opposite corner of the 19x19 board.
;; B(17,18), W(0,0), B(18,17). W(18,18) has no liberty and captures nothing.
(go:reset!)
(must (go:place! 1 17 18))
(must (go:place! 2 0 0))
(must (go:place! 1 18 17))
(expect "EDGE_SUICIDE" (go:place! 2 18 18) 0)
(expect "EDGE_SUICIDE_EMPTY" (go:at 18 18) 0)
(expect "EDGE_TO_PLAY" *to-play* 2)
(expect "EMPTY19" (go:empty-count) 358)

(if (= *fail* 0)
    (begin
      (display "GO_M0_OK")
      (newline)
      (display "GO_19_OK")
      (newline))
    (begin
      (display "GO_M0_FAIL")
      (newline)
      (display "GO_19_FAIL")
      (newline)))
