;; Self-evolve burn. Propose → gate → play → score.
;; Each color keeps a new place-fn only when its own signal improves:
;; capture count, then fewer locally-thin stones, then stones, then lead.
;; Not territory. Not Elo. Worldline stamp is whatever the duel measured.

(load "/workspace/aura-go/soft/go/duel.aura")
(load "/workspace/aura-go/soft/go/propose.aura")

(define *last-lead* 0)
(define *kept-black* 0)
(define *kept-white* 0)
(define *base-caps-b* -1)
(define *base-caps-w* -1)
(define *base-stones-b* -1)
(define *base-stones-w* -1)
(define *base-thin-b* 9999)
(define *base-thin-w* 9999)
(define *base-lead* 0)
(define *keep-b* 0)
(define *keep-w* 0)

(define (go:env-int name fallback)
  (let ((raw (getenv name)))
    (if (and (string? raw) (> (string-length raw) 0))
        (let ((n (string->number raw)))
          (if (number? n) n fallback))
        fallback)))

(define (go:file-body path)
  (if (and (string? path) (> (string-length path) 0))
      (let ((b (try (read-file path) (catch (e) #f))))
        (if (string? b) b #f))
      #f))

(define (go:maybe-base! color envn)
  (let ((b (go:file-body (getenv envn))))
    (if (string? b)
        (go:apply-strategy! color b)
        #f)))

(define (go:scoreboard!)
  (display "SCOREBOARD rounds=")
  (display (number->string *burn-rounds*))
  (display " black_wins=")
  (display (number->string *black-wins*))
  (display " white_wins=")
  (display (number->string *white-wins*))
  (display " draws=")
  (display (number->string *draws*))
  (display " kept_black=")
  (display (number->string *kept-black*))
  (display " kept_white=")
  (display (number->string *kept-white*))
  (newline)
  (display "CAPS black=")
  (display (number->string *caps-black*))
  (display " white=")
  (display (number->string *caps-white*))
  (display " lead=")
  (display (number->string (go:capture-lead)))
  (newline)
  (display "ALIVE stones_b=")
  (display (number->string (go:stones 1)))
  (display " stones_w=")
  (display (number->string (go:stones 2)))
  (newline)
  (display "THIN black=")
  (display (number->string (go:thin-count 1)))
  (display " white=")
  (display (number->string (go:thin-count 2)))
  (display " lib_weight=")
  (display (number->string *lib-weight*))
  (newline)
  (display "KEEP black=")
  (display (number->string *keep-b*))
  (display " white=")
  (display (number->string *keep-w*))
  (newline)
  (display "BASE caps_b=")
  (display (number->string *base-caps-b*))
  (display " caps_w=")
  (display (number->string *base-caps-w*))
  (display " stones_b=")
  (display (number->string *base-stones-b*))
  (display " stones_w=")
  (display (number->string *base-stones-w*))
  (display " thin_b=")
  (display (number->string *base-thin-b*))
  (display " thin_w=")
  (display (number->string *base-thin-w*))
  (display " lead=")
  (display (number->string *base-lead*))
  (newline)
  (go:stamp-world!)
  (display "EXPLAIN mid=")
  (display (number->string *explain-mid*))
  (display " reason=")
  (display *explain-reason*)
  (newline)
  (display "LIVE_BLACK ")
  (display *black-live*)
  (newline)
  (display "LIVE_WHITE ")
  (display *white-live*)
  (newline))

(define (go:revert-side! color body)
  (go:apply-strategy! color body))

;; No history yet (caps baseline < 0): the first measured body is kept.
;; After that a side keeps only on a strictly richer own signal.
(define (go:better-black? caps stones thin lead)
  (cond
    ((< *base-caps-b* 0) #t)
    ((> caps *base-caps-b*) #t)
    ((and (= caps *base-caps-b*) (< thin *base-thin-b*)) #t)
    ((and (= caps *base-caps-b*) (= thin *base-thin-b*) (> stones *base-stones-b*)) #t)
    ((and (= caps *base-caps-b*) (= thin *base-thin-b*)
          (= stones *base-stones-b*) (> lead *base-lead*)) #t)
    (#t #f)))

(define (go:better-white? caps stones thin lead)
  (cond
    ((< *base-caps-w* 0) #t)
    ((> caps *base-caps-w*) #t)
    ((and (= caps *base-caps-w*) (< thin *base-thin-w*)) #t)
    ((and (= caps *base-caps-w*) (= thin *base-thin-w*) (> stones *base-stones-w*)) #t)
    ((and (= caps *base-caps-w*) (= thin *base-thin-w*)
          (= stones *base-stones-w*) (< lead *base-lead*)) #t)
    (#t #f)))

(define (go:burn-round! size max-moves propose-mode)
  (if (not (go:duel-boot! size))
      (begin
        (display "GO_BURN_FAIL seed\n")
        #f)
      (begin
        (go:maybe-base! 1 "GO_BASE_FILE_BLACK")
        (go:maybe-base! 2 "GO_BASE_FILE_WHITE")
        (let ((prev-b *black-live*)
              (prev-w *white-live*))
          (if (= propose-mode 1)
              (begin
                (go:propose! 1)
                (go:propose! 2)))
          (let ((tried-b *black-live*)
                (tried-w *white-live*))
            (let ((res (go:duel-play! max-moves)))
              (let ((lead (car res))
                    (caps-b (car (cdr res)))
                    (caps-w (car (cdr (cdr res))))
                    (stones-b (car (cdr (cdr (cdr (cdr res))))))
                    (stones-w (car (cdr (cdr (cdr (cdr (cdr res)))))))
                    (thin-b (go:thin-count 1))
                    (thin-w (go:thin-count 2)))
                (set! *burn-rounds* (+ *burn-rounds* 1))
                (set! *last-lead* lead)
                (set! *keep-b* 0)
                (set! *keep-w* 0)
                (cond
                  ((> lead 0) (set! *black-wins* (+ *black-wins* 1)))
                  ((< lead 0) (set! *white-wins* (+ *white-wins* 1)))
                  (#t (set! *draws* (+ *draws* 1))))
                (if (string=? tried-b prev-b)
                    0
                    (if (go:better-black? caps-b stones-b thin-b lead)
                        (begin
                          (set! *keep-b* 1)
                          (set! *kept-black* (+ *kept-black* 1))
                          (set! *base-caps-b* caps-b)
                          (set! *base-stones-b* stones-b)
                          (set! *base-thin-b* thin-b))
                        (go:revert-side! 1 prev-b)))
                (if (string=? tried-w prev-w)
                    0
                    (if (go:better-white? caps-w stones-w thin-w lead)
                        (begin
                          (set! *keep-w* 1)
                          (set! *kept-white* (+ *kept-white* 1))
                          (set! *base-caps-w* caps-w)
                          (set! *base-stones-w* stones-w)
                          (set! *base-thin-w* thin-w))
                        (go:revert-side! 2 prev-w)))
                (if (or (= *keep-b* 1) (= *keep-w* 1)
                        (and (string=? tried-b prev-b) (string=? tried-w prev-w)
                             (< *base-caps-b* 0)))
                    (set! *base-lead* lead))
                (display "BURN_ROUND=")
                (display (number->string *burn-rounds*))
                (newline)
                (display "LEAD=")
                (display (number->string lead))
                (newline)
                (display "MOVES=")
                (display (number->string (car (cdr (cdr (cdr res))))))
                (newline)
                (go:scoreboard!)
                res)))))))

(define (go:burn! rounds size max-moves propose-mode)
  (set! *burn-rounds* 0)
  (set! *black-wins* 0)
  (set! *white-wins* 0)
  (set! *draws* 0)
  (set! *kept-black* 0)
  (set! *kept-white* 0)
  (set! *base-caps-b* (go:env-int "GO_BASE_CAPS_B" -1))
  (set! *base-caps-w* (go:env-int "GO_BASE_CAPS_W" -1))
  (set! *base-stones-b* (go:env-int "GO_BASE_STONES_B" -1))
  (set! *base-stones-w* (go:env-int "GO_BASE_STONES_W" -1))
  (set! *base-thin-b* (go:env-int "GO_BASE_THIN_B" 9999))
  (set! *base-thin-w* (go:env-int "GO_BASE_THIN_W" 9999))
  (set! *base-lead* (go:env-int "GO_BASE_LEAD" 0))
  (let loop ((i 0))
    (if (>= i rounds)
        (begin
          (display "GO_BURN_OK\n")
          (go:scoreboard!)
          #t)
        (begin
          (go:burn-round! size max-moves propose-mode)
          (loop (+ i 1))))))
