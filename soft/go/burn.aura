; Self-evolve burn. Several propose → gate → play → score rounds on 9×9.
; Each color keeps the better place-fn by capture-lead (not territory).
; Prefer 9×9 for speed; product default stays 19. host-sequential.

(load "/workspace/aura-go/soft/go/duel.aura")
(load "/workspace/aura-go/soft/go/propose.aura")

(define *last-lead* 0)
(define *kept-black* 0)
(define *kept-white* 0)

(define (go:scoreboard!)
  (display "SCOREBOARD rounds=")
  (display (number->string *burn-rounds*))
  (display " black_wins=")
  (display (number->string *black-wins*))
  (display " white_wins=")
  (display (number->string *white-wins*))
  (display " draws=")
  (display (number->string *draws*))
  (display " kept_black=")
  (display (number->string *kept-black*))
  (display " kept_white=")
  (display (number->string *kept-white*))
  (newline)
  (display "CAPS black=")
  (display (number->string *caps-black*))
  (display " white=")
  (display (number->string *caps-white*))
  (display " lead=")
  (display (number->string (go:capture-lead)))
  (newline)
  (display "ALIVE stones_b=")
  (display (number->string (go:stones 1)))
  (display " stones_w=")
  (display (number->string (go:stones 2)))
  (newline)
  (go:stamp-world!)
  (display "EXPLAIN mid=")
  (display (number->string *explain-mid*))
  (display " reason=")
  (display *explain-reason*)
  (newline))

; Restore a side onto a prior body without counting it as a propose.
(define (go:revert-side! color body)
  (go:apply-strategy! color body))

; One burn round: optional propose per side, play max-moves, keep winners.
; propose-mode: 0 = no propose (baseline bodies), 1 = host/file propose both.
(define (go:burn-round! size max-moves propose-mode)
  (if (not (go:duel-boot! size))
      (begin
        (display "GO_BURN_FAIL seed\n")
        #f)
      (let ((prev-b *black-live*)
            (prev-w *white-live*))
        (if (= propose-mode 1)
            (begin
              (go:propose! 1)
              (go:propose! 2)))
        (let* ((tried-b *black-live*)
               (tried-w *white-live*)
               (res (go:duel-play! max-moves))
               (lead (car res)))
          (set! *burn-rounds* (+ *burn-rounds* 1))
          (set! *last-lead* lead)
          (cond
            ((> lead 0)
             (set! *black-wins* (+ *black-wins* 1))
             (set! *kept-black* (+ *kept-black* 1))
             ; Black won: keep black try; revert white if it changed and lost.
             (if (not (string=? tried-w prev-w))
                 (go:revert-side! 2 prev-w)))
            ((< lead 0)
             (set! *white-wins* (+ *white-wins* 1))
             (set! *kept-white* (+ *kept-white* 1))
             (if (not (string=? tried-b prev-b))
                 (go:revert-side! 1 prev-b)))
            (#t
             (set! *draws* (+ *draws* 1))
             ; Draw: revert both proposed bodies (no improvement signal).
             (if (not (string=? tried-b prev-b))
                 (go:revert-side! 1 prev-b))
             (if (not (string=? tried-w prev-w))
                 (go:revert-side! 2 prev-w))))
          (display "BURN_ROUND=")
          (display (number->string *burn-rounds*))
          (newline)
          (display "LEAD=")
          (display (number->string lead))
          (newline)
          (display "MOVES=")
          (display (number->string (car (cdr (cdr (cdr res))))))
          (newline)
          (go:scoreboard!)
          res))))

(define (go:burn! rounds size max-moves propose-mode)
  (set! *burn-rounds* 0)
  (set! *black-wins* 0)
  (set! *white-wins* 0)
  (set! *draws* 0)
  (set! *kept-black* 0)
  (set! *kept-white* 0)
  (let loop ((i 0))
    (if (>= i rounds)
        (begin
          (display "GO_BURN_OK\n")
          (go:scoreboard!)
          #t)
        (begin
          (go:burn-round! size max-moves propose-mode)
          (loop (+ i 1))))))
